<!-- SGML defs.; system IDs are merely placeholders -->
<!-- <!ENTITY % PersChars SYSTEM "PersSGML.ent"> -->
<!ENTITY % PersChars SYSTEM "PersXML.ent">
<!ENTITY % ISOlat1 PUBLIC "ISO 8879-1986//ENTITIES Added Latin 1//EN" "ISO8879/isolat1.ent">
<!ENTITY % ISOlat2 PUBLIC "ISO 8879-1986//ENTITIES Added Latin 2//EN" "ISO8879/isolat2.ent">
<!ENTITY % ISOnum PUBLIC "ISO 8879-1986//ENTITIES Numeric and Special Graphic//EN" "ISO8879/isonum.ent">
<!ENTITY % ISOpub PUBLIC "ISO 8879-1986//ENTITIES Publishing//EN" "ISO8879/isopub.ent">
<!ENTITY % ISOtech PUBLIC "ISO 8879-1986//ENTITIES General Technical//EN" "ISO8879/isotech.ent">
<!ENTITY % ISOdia PUBLIC "ISO 8879-1986//ENTITIES Diacritical Marks//EN" "ISO8879/isodia.ent">

<!-- Load files -->
%PersChars;
%ISOlat1; 
%ISOlat2; 
%ISOnum;
%ISOpub; 
%ISOtech;
%ISOdia;

